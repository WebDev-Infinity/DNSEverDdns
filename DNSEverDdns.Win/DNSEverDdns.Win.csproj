<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DNSEverDdns.Core\DNSEverDdns.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <Target Name="RenamePublishedExecutable" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <PublishedExecutablePath>$(PublishDir)$(AssemblyName).exe</PublishedExecutablePath>
      <RenamedExecutablePath>$(PublishDir)DNSEverDdns-$(InformationalVersion)-$(RuntimeIdentifier).exe</RenamedExecutablePath>
    </PropertyGroup>

    <ItemGroup>
      <PreviousPublishedExecutables Include="$(PublishDir)DNSEverDdns-*.exe" />
    </ItemGroup>

    <Delete Files="@(PreviousPublishedExecutables)" />
    <Move SourceFiles="$(PublishedExecutablePath)"
          DestinationFiles="$(RenamedExecutablePath)"
          Condition="Exists('$(PublishedExecutablePath)')" />
  </Target>

</Project>
